# Copy to `keystore.properties` (git-ignored) and fill in real values.
# Never commit the resulting file or the keystore it points to.
#
# storeFile      path to the .keystore, relative to the repository root
# storePassword  keystore password
# keyAlias       key alias inside the keystore
# keyPassword    key password (often the same as storePassword)

storeFile=app/keystore/moodtunes-upload.jks
storePassword=CHANGE_ME
keyAlias=moodtunes
keyPassword=CHANGE_ME
